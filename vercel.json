{
  "rewrites": [
    {
      "source": "/shiprocket-checkout",
      "destination": "https://subhamapi.hypernxt.space/shiprocket-checkout"
    },
    {
      "source": "/shiprocket-checkout/:path*",
      "destination": "https://subhamapi.hypernxt.space/shiprocket-checkout/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://subhamapi.hypernxt.space/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://subhamapi.hypernxt.space/uploads/:path*"
    },
    {
      "source": "/og/product/:slug",
      "destination": "https://subhamapi.hypernxt.space/api/og/product/:slug"
    },
    {
      "source": "/share/product/:slug",
      "destination": "https://subhamapi.hypernxt.space/api/og/product/:slug"
    },
    {
      "source": "/product/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(TelegramBot|WhatsApp|facebookexternalhit|Twitterbot|LinkedInBot|bot|crawler|spider).*"
        }
      ],
      "destination": "https://subhamapi.hypernxt.space/api/og/product/:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
